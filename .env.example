# Discord Bot Token - Discord Developer Portal'dan alınır
DISCORD_TOKEN=your_discord_token_here

# Bot Prefix (varsayılan: !)
BOT_PREFIX=!
DATA_DIR=data
PORT=8080
MAX_QUERY_LENGTH=300
# Yalnızca https://discord.com/api/webhooks/... kabul edilir
ERROR_WEBHOOK_URL=
# /metrics için uzun ve rastgele bir bearer token belirleyin
HEALTH_METRICS_TOKEN=
# Ortak izleme sayfasının genel HTTPS adresi. Railway public domain varsa otomatik algılanır.
PUBLIC_BASE_URL=
